# Enforce the Node version range declared in package.json "engines".
# Without this, a contributor on an old Node gets confusing runtime errors
# instead of a clear "wrong Node version" message at install time.
engine-strict=true

# Warn, rather than hard-fail, when a package asks for a peer version we do
# not have. Storybook and Astro plugins routinely lag behind React releases;
# without this a valid install aborts on a version range that is only advisory.
strict-peer-dependencies=false
